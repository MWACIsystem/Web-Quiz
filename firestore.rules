rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function playerPath(uid) {
      return /databases/$(database)/documents/players/$(uid);
    }

    function attemptPath(uid, attemptId) {
      return /databases/$(database)/documents/players/$(uid)/attempts/$(attemptId);
    }

    function previousAttemptCount() {
      return resource.data.keys().hasAny(['attemptCount'])
        ? resource.data.attemptCount
        : (resource.data.keys().hasAny(['played']) && resource.data.played == true ? 1 : 0);
    }

    function validRegistration() {
      return request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'displayName', 'phone', 'attemptCount', 'registeredAt'
        ])
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'displayName', 'phone', 'attemptCount', 'registeredAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && request.resource.data.attemptCount == 0
        && request.resource.data.registeredAt == request.time;
    }

    function validAttemptData(data) {
      return data.displayName is string
        && data.attemptNumber is int
        && data.attemptNumber >= 1
        && data.score is int
        && data.score >= 0
        && data.score <= 100
        && data.correctCount is int
        && data.correctCount >= 0
        && data.correctCount <= 5
        && data.score == data.correctCount * 20
        && data.totalQuestions == 5
        && data.submittedAt == request.time;
    }

    function attemptMatches(uid, attemptId, data) {
      let path = attemptPath(uid, attemptId);
      return existsAfter(path)
        && getAfter(path).data.displayName == data.displayName
        && getAfter(path).data.score == data.bestScore
        && getAfter(path).data.correctCount == data.bestCorrectCount
        && getAfter(path).data.totalQuestions == data.totalQuestions
        && getAfter(path).data.submittedAt == data.bestSubmittedAt;
    }

    function validBestScoreData(uid) {
      return request.resource.data.keys().hasAll([
          'displayName', 'bestScore', 'bestCorrectCount', 'totalQuestions',
          'bestSubmittedAt', 'latestAttemptId'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'bestScore', 'bestCorrectCount', 'totalQuestions',
          'bestSubmittedAt', 'latestAttemptId'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 100
        && request.resource.data.bestCorrectCount is int
        && request.resource.data.bestCorrectCount >= 0
        && request.resource.data.bestCorrectCount <= 5
        && request.resource.data.bestScore == request.resource.data.bestCorrectCount * 20
        && request.resource.data.totalQuestions == 5
        && request.resource.data.bestSubmittedAt == request.time
        && request.resource.data.latestAttemptId is string
        && attemptMatches(uid, request.resource.data.latestAttemptId, request.resource.data);
    }

    match /players/{uid} {
      // A player can read only their own private profile, including the phone number.
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validRegistration();

      // Each submission increments the counter and creates a distinct attempt document.
      // getAfter() ties the profile update to that attempt in the same transaction.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attemptCount', 'lastPlayedAt', 'lastAttemptId'
        ])
        && request.resource.data.attemptCount is int
        && request.resource.data.attemptCount == previousAttemptCount() + 1
        && request.resource.data.lastPlayedAt == request.time
        && request.resource.data.lastAttemptId is string
        && existsAfter(attemptPath(uid, request.resource.data.lastAttemptId))
        && getAfter(attemptPath(uid, request.resource.data.lastAttemptId)).data.attemptNumber == request.resource.data.attemptCount
        && getAfter(attemptPath(uid, request.resource.data.lastAttemptId)).data.displayName == resource.data.displayName
        && getAfter(attemptPath(uid, request.resource.data.lastAttemptId)).data.submittedAt == request.time;

      allow delete: if false;

      match /attempts/{attemptId} {
        // Attempt history is private to its owner.
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll([
            'displayName', 'attemptNumber', 'score', 'correctCount', 'totalQuestions', 'submittedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'displayName', 'attemptNumber', 'score', 'correctCount', 'totalQuestions', 'submittedAt'
          ])
          && validAttemptData(request.resource.data)
          && exists(playerPath(uid))
          && getAfter(playerPath(uid)).data.attemptCount == request.resource.data.attemptNumber
          && getAfter(playerPath(uid)).data.lastAttemptId == attemptId
          && getAfter(playerPath(uid)).data.lastPlayedAt == request.time
          && getAfter(playerPath(uid)).data.displayName == request.resource.data.displayName;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{uid} {
      // Public leaderboard contains only display names and each user's best score.
      allow get, list: if true;

      allow create: if isOwner(uid) && validBestScoreData(uid);

      // A leaderboard row can only be replaced by a strictly higher score.
      // The update is linked to the new attempt in the same Firestore transaction.
      // The legacy `score` field is supported for existing test data from the prior build.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'score', 'correctCount', 'submittedAt', 'bestScore',
          'bestCorrectCount', 'totalQuestions', 'bestSubmittedAt', 'latestAttemptId'
        ])
        && request.resource.data.bestScore > (resource.data.keys().hasAny(['bestScore'])
          ? resource.data.bestScore
          : resource.data.get('score', -1))
        && validBestScoreData(uid);

      allow delete: if false;
    }

    match /phoneIndex/{documentId} {
      allow read, write: if false;
    }
  }
}
